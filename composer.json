{
    "name": "shlinkio/shlink-json",
    "type": "library",
    "homepage": "https://shlink.io",
    "description": "JSON encoding/decoding utilities",
    "license": "MIT",
    "authors": [
        {
            "name": "Alejandro Celaya Alastrué",
            "homepage": "https://www.alejandrocelaya.com",
            "email": "alejandro@alejandrocelaya.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "carthage-software/mago": "^1.28",
        "shlinkio/shlink-mago-config": "^1.0"
    },
    "autoload": {
        "files": [
            "functions/functions.php"
        ]
    },
    "scripts": {
        "ci": [
            "@cs",
            "@analyze"
        ],
        "lint": "mago lint",
        "lint:fix": "mago lint --fix",
        "format": "mago format",
        "format:check": "mago format --check",
        "cs": ["@lint", "@format:check"],
        "cs:fix": ["@lint:fix", "@format"],
        "analyze": "mago analyze",
        "stan": "@analyze"
    },
    "scripts-descriptions": {
        "ci": "<fg=blue;options=bold>Alias for \"cs\" and \"analyze\"</>",
        "cs": "<fg=blue;options=bold>Checks coding styles</>",
        "cs:fix": "<fg=blue;options=bold>Fixes coding styles, when possible</>",
        "analyze": "<fg=blue;options=bold>Inspects code with mago analyze</>"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
